# Atoms Lite Backend Environment Variables
# Copy to .env for local development, or set in Railway Dashboard for production

# OpenAI Compatible API (required for AI mode; leave empty for demo mode)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# Database
# Local dev:  sqlite+aiosqlite:///./atoms_lite.db  (creates ./atoms_lite.db)
# Railway:   mount a volume at /data, then set:
#            DATABASE_URL=sqlite+aiosqlite:////data/atoms_lite.db
#            (otherwise the DB is wiped on every redeploy)
DATABASE_URL=sqlite+aiosqlite:///./atoms_lite.db

# CORS origins (comma-separated, REQUIRED in production)
# Example: https://your-app.vercel.app,https://your-custom-domain.com
# Empty = same-origin only (no cross-origin). Do NOT use * in production.
CORS_ORIGINS=

# Server
HOST=0.0.0.0
PORT=8000
