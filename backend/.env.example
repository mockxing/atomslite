# Atoms Lite Backend Environment Variables
# Copy to .env for local development, or set in Railway Dashboard for production

# OpenAI Compatible API (required for AI mode; leave empty for demo mode)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# Database (local dev: ./atoms_lite.db; Railway: /data/atoms_lite.db with volume mounted)
DATABASE_URL=sqlite+aiosqlite:///./atoms_lite.db

# CORS origins (comma-separated, or * for all)
# Production: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# Server
HOST=0.0.0.0
PORT=8000
